# Example only — NEVER paste your real .env or secrets into AI Chat, logs or ZIPs.
# The owner creates apps/api/.env privately. Agents may read ONLY this .example.
APP_ENV=local
APP_HOST=127.0.0.1
APP_PORT=3000
AWS_REGION=ap-south-1
DYNAMODB_ENDPOINT=http://127.0.0.1:8000
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
ULUV_DEV_TOKEN=REPLACE_WITH_OWNER_GENERATED_LOCAL_TOKEN
# Cloud OFF by default even if owner already created DEV S3/CloudFront.
MEDIA_STORAGE_DRIVER=local
MEDIA_ENV=development
# No AWS bucket names, actual credentials, signing keys or presigned URLs here.
