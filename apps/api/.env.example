# Example only — NEVER paste your real .env or secrets into AI Chat, logs or ZIPs.
# The owner creates apps/api/.env privately. Agents may read ONLY this .example.
APP_ENV=local
APP_HOST=127.0.0.1
APP_PORT=3000
AWS_REGION=ap-south-1
DYNAMODB_ENDPOINT=http://127.0.0.1:8000
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
ULUV_DEV_TOKEN=REPLACE_WITH_OWNER_GENERATED_LOCAL_TOKEN
# Cloud OFF by default even if owner already created DEV S3/CloudFront.
MEDIA_STORAGE_DRIVER=local
MEDIA_ENV=development
# No AWS bucket names, actual credentials, signing keys or presigned URLs here.
# P03: ALL GeoNames JSON in the SAME S3 bucket via CloudFront OAC.
# CloudFront HTTPS URL must be the ROOT of the versioned dataset.
# ULUV_GEO_PUBLIC_BASE_URL=https://REPLACE-WITH-YOUR-DISTRIBUTION.cloudfront.net/geo/india/v1/
# Independently pinned SHA256 of server-index-manifest.json. NOT fetched from CDN.
# ULUV_GEO_CANONICAL_MANIFEST_SHA256=8f4c54c2acbf474fba5ee07eefa86c4e86903299af04a0a9e57f0fa72c8f9caa
# Offline test fallback: external local directory holding ALL geo JSON, including server/.
# Leave ULUV_GEO_PUBLIC_BASE_URL unset when using local provider.
# ULUV_GEO_PUBLIC_LOCAL_DIR=C:\Dump\Uluv-Geo-Local\geo\india\v1
# No ULUV_GEO_PRIVATE_DIR needed. No AWS access keys or SDK requests for GeoNames.
# For a future verified India Post CSV import; otherwise PIN lookup stays unavailable:
# ULUV_PIN_PRIVATE_DIR=C:\Dump\Uluv-Postal-Private\india\v1
