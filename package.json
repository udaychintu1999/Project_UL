{
  "name": "uluv",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/api"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace apps/api",
    "db:provision": "node --env-file=apps/api/.env scripts/db/provision.mjs",
    "test:unit": "node --experimental-strip-types --test apps/api/tests/unit/*.test.ts",
    "test:integration": "node --env-file=apps/api/.env scripts/verify/p00-integration.mjs",
    "test:local-guards": "node --test scripts/verify/p00-local-endpoints.test.mjs",
    "test:contracts": "node scripts/verify/source-contract.mjs",
    "test:docs": "node scripts/verify/docs-check.mjs",
    "test:portable": "npm run test:unit && npm run test:local-guards && npm run test:dev-cli && npm run test:env-init && npm run test:contracts && npm run test:docs && npm run test:environment && npm run test:secrets && npm run test:cloud-guards",
    "test:environment": "node scripts/verify/local-environment-contract.mjs",
    "test:secrets": "node scripts/verify/secret-guard.mjs",
    "test:cloud-guards": "node scripts/verify/cloud-operation-guard.mjs",
    "typecheck": "npm run typecheck --workspace apps/api",
    "verify:p00": "node scripts/verify/p00-verifier.mjs",
    "test:db": "node --env-file=apps/api/.env scripts/verify/p00-db-direct.mjs",
    "env:init": "node scripts/dev/generate-token.mjs",
    "flutter:setup": "node scripts/dev/flutter.mjs setup",
    "dev:flutter": "node --env-file=apps/api/.env scripts/dev/flutter.mjs run",
    "test:flutter": "node scripts/dev/flutter.mjs test",
    "test:flutter:e2e": "node --env-file=apps/api/.env scripts/dev/flutter.mjs e2e",
    "verify:p00:portable": "npm run test:portable",
    "test:dev-cli": "node --test scripts/verify/p00-dev-cli.test.mjs",
    "test:env-init": "node --test scripts/verify/p00-env-init.test.mjs",
    "test:p01:integration": "node --env-file=apps/api/.env scripts/verify/p01-email-integration.mjs",
    "verify:p01:portable": "npm run test:portable && npm run test:p01:contracts",
    "verify:p01": "node scripts/verify/p01-verifier.mjs",
    "test:flutter:p01:e2e": "node --env-file=apps/api/.env scripts/dev/flutter.mjs p01-e2e",
    "test:p01:contracts": "node scripts/verify/p01-source-contract.mjs",
    "test:p01:password:integration": "node --env-file=apps/api/.env scripts/verify/p01-password-integration.mjs",
    "test:p01:password:contracts": "node scripts/verify/p01-password-contract.mjs",
    "verify:p01-2:portable": "npm run verify:p01:portable && npm run test:p01:password:contracts && npm run test:p01:automation:contracts",
    "verify:p01-2": "node scripts/verify/p01-2-verifier.mjs",
    "test:flutter:p01-2:e2e": "node --env-file=apps/api/.env scripts/verify/p01-2-android-e2e.mjs",
    "test:p01:automation:contracts": "node --test scripts/verify/p01-2-automation.test.mjs",
    "test:p01:email-budget:integration": "node --env-file=apps/api/.env scripts/verify/p01-email-budget-integration.mjs",
    "test:p01-3:contracts": "node scripts/verify/p01-3-source-contract.mjs",
    "test:p01-3:integration": "node --env-file=apps/api/.env scripts/verify/p01-3-device-integration.mjs",
    "test:flutter:p01-3:e2e": "node --env-file=apps/api/.env scripts/verify/p01-3-android-e2e.mjs",
    "verify:p01-3:portable": "npm run verify:p01-2:portable && npm run test:p01-3:contracts",
    "verify:p01-3": "node scripts/verify/p01-3-verifier.mjs",
    "lint:api": "eslint \"apps/api/src/**/*.ts\" \"apps/api/tests/unit/**/*.ts\"",
    "lint:scripts": "eslint \"scripts/**/*.mjs\"",
    "lint": "npm run lint:api && npm run lint:scripts",
    "format:api:check": "prettier --check \"apps/api/src/**/*.ts\" \"apps/api/tests/unit/**/*.ts\"",
    "format:api:write": "prettier --write \"apps/api/src/**/*.ts\" \"apps/api/tests/unit/**/*.ts\"",
    "format:scripts:check": "prettier --check \"scripts/**/*.mjs\"",
    "logs:pretty": "pino-pretty",
    "check:dev": "npm run typecheck && npm run lint",
    "test:dev-workflow": "node --test scripts/verify/dev-workflow.test.mjs",
    "test:p02-1:integration": "node --env-file=apps/api/.env scripts/verify/p02-1-profile-integration.mjs",
    "verify:p02-1:portable": "npm run verify:p01-3:portable && npm run test:p02-1:contracts && npm run test:p02-1:navigation:contracts && npm run test:p02-1:android-package",
    "verify:p02-1": "npm run verify:p01-3 && npm run test:p02-1:contracts && npm run lint && npm run test:p02-1:integration && npm run test:flutter:p02-1:e2e",
    "test:p02-1:contracts": "node scripts/verify/p02-1-source-contract.mjs",
    "test:flutter:p02-1:e2e": "node --env-file=apps/api/.env scripts/verify/p02-1-android-e2e.mjs",
    "test:p02-1:navigation:contracts": "node --test scripts/verify/p02-1-account-navigation.test.mjs",
    "test:p02-1:android-package": "node --test scripts/verify/p02-1-android-package.test.mjs",
    "test:p02-2:integration": "node --env-file=apps/api/.env scripts/verify/p02-2-media-integration.mjs",
    "test:flutter:p02-2:e2e": "node --env-file=apps/api/.env scripts/verify/p02-2-android-e2e.mjs",
    "test:flutter:p02-2:ui:e2e": "node --env-file=apps/api/.env scripts/verify/p02-2-android-e2e.mjs --ui",
    "test:p02-2:contracts": "node --test scripts/verify/p02-2-contracts.test.mjs",
    "test:p02-2:ui:contracts": "node --test scripts/verify/p02-2-ui-journey.test.mjs",
    "verify:p02-2:portable": "npm run verify:p02-1:portable && npm run test:p02-2:contracts && npm run test:p02-2:ui:contracts && npm run test:p02-2:guided:contracts",
    "verify:p02-2": "npm run verify:p02-2:portable && npm run typecheck && npm run lint && npm run test:p02-2:store && npm run test:flutter && npm run test:p02-2:integration && npm run test:flutter:p02-2:e2e && npm run test:flutter:p02-2:ui:e2e",
    "test:p02-2:store": "tsx --test apps/api/tests/p02-2-media-store.test.ts",
    "test:p02-2:guided:contracts": "node --test scripts/verify/p02-2-guided-onboarding.test.mjs",
    "test:p02-3:contracts": "node --test scripts/verify/p02-3-activation-contracts.test.mjs",
    "verify:p02-3:portable": "npm run verify:p02-2:portable && npm run test:p02-3:contracts",
    "test:p02-3:integration": "node --env-file=apps/api/.env scripts/verify/p02-3-activation-integration.mjs",
    "test:flutter:p02-3:e2e": "node --env-file=apps/api/.env scripts/verify/p02-2-android-e2e.mjs --ui",
    "verify:p02-3": "npm run verify:p02-3:portable && npm run typecheck && npm run lint && npm run test:p02-2:store && npm run test:flutter && npm run test:p02-1:integration && npm run test:p02-2:integration && npm run test:p02-3:integration && npm run test:flutter:p02-3:e2e",
    "test:p02-4:contracts": "node --test scripts/verify/p02-4-verifier.test.mjs",
    "verify:p02-4:portable": "npm run verify:p02-3:portable && npm run test:p02-4:contracts",
    "verify:p02-4:plan": "node scripts/verify/p02-4-verifier.mjs --list",
    "verify:p02-4": "node --env-file=apps/api/.env scripts/verify/p02-4-verifier.mjs"
  },
  "devDependencies": {
    "eslint": "^10.15.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.72.2"
  }
}
